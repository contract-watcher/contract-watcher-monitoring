{
  "info": {
    "name": "Monitoring: ручная проверка приема отчетов",
    "description": "Запускайте запросы по порядку в отдельной локальной БД без рабочих данных. Новые ID создаются автоматически. Запрос 3 повторяет ID из запроса 1. Авторизация пока не реализована. Не содержит настроек подключения к БД или секретов.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "integrationId",
      "value": "22222222-2222-4222-8222-222222222222",
      "type": "string"
    },
    {
      "key": "contractId",
      "value": "33333333-3333-4333-8333-333333333333",
      "type": "string"
    },
    {
      "key": "passedReportId",
      "value": "",
      "type": "string"
    },
    {
      "key": "failedReportId",
      "value": "",
      "type": "string"
    },
    {
      "key": "invalidReportId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Passed: сохранить отчет без нарушений",
      "description": "",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"passedReportId\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201: отчет сохранен\", () => pm.response.to.have.status(201));",
              "pm.test(\"Подтверждение содержит ID, время UTC и duplicate=false\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.reportId).to.eql(pm.collectionVariables.get(\"passedReportId\"));",
              "  pm.collectionVariables.set(\"passedReceivedAt\", body.receivedAt);",
              "  pm.expect(body.integrationId).to.eql(pm.collectionVariables.get(\"integrationId\"));",
              "  pm.expect(body.duplicate).to.eql(false);",
              "  pm.expect(body.receivedAt).to.match(/Z$/);",
              "  pm.expect(Number.isNaN(Date.parse(body.receivedAt))).to.eql(false);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"integrationId\": \"{{integrationId}}\",\n  \"contractId\": \"{{contractId}}\",\n  \"report\": {\n    \"reportId\": \"{{passedReportId}}\",\n    \"contractVersion\": 3,\n    \"status\": \"Passed\",\n    \"violations\": []\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/internal/v1/reports"
      }
    },
    {
      "name": "2. Failed: сохранить все нарушения",
      "description": "",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"failedReportId\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201: отчет сохранен\", () => pm.response.to.have.status(201));",
              "pm.test(\"Подтверждение содержит ID, время UTC и duplicate=false\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.reportId).to.eql(pm.collectionVariables.get(\"failedReportId\"));",
              "  pm.expect(body.integrationId).to.eql(pm.collectionVariables.get(\"integrationId\"));",
              "  pm.expect(body.duplicate).to.eql(false);",
              "  pm.expect(body.receivedAt).to.match(/Z$/);",
              "  pm.expect(Number.isNaN(Date.parse(body.receivedAt))).to.eql(false);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"integrationId\": \"{{integrationId}}\",\n  \"contractId\": \"{{contractId}}\",\n  \"report\": {\n    \"reportId\": \"{{failedReportId}}\",\n    \"contractVersion\": 3,\n    \"status\": \"Failed\",\n    \"violations\": [\n      {\n        \"fieldName\": \"customer_id\",\n        \"type\": \"RequiredFieldMissing\",\n        \"expectedType\": \"String\",\n        \"actualType\": null\n      },\n      {\n        \"fieldName\": \"amount\",\n        \"type\": \"TypeMismatch\",\n        \"expectedType\": \"Number\",\n        \"actualType\": \"String\"\n      },\n      {\n        \"fieldName\": \"amount\",\n        \"type\": \"TypeMismatch\",\n        \"expectedType\": \"Number\",\n        \"actualType\": \"String\"\n      },\n      {\n        \"fieldName\": \"optional\",\n        \"type\": \"NullNotAllowed\",\n        \"expectedType\": \"Boolean\"\n      }\n    ]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/internal/v1/reports"
      }
    },
    {
      "name": "3. Повтор: получить 200",
      "description": "Сначала выполните запрос 1. Здесь используется тот же reportId, новый ID не создается.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200: прежнее подтверждение, duplicate=true\", () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "  const body = pm.response.json();",
              "  pm.expect(body.reportId).to.eql(pm.collectionVariables.get(\"passedReportId\"));",
              "  pm.expect(body.integrationId).to.eql(pm.collectionVariables.get(\"integrationId\"));",
              "  pm.expect(body.duplicate).to.eql(true);",
              "  pm.expect(body.receivedAt).to.eql(pm.collectionVariables.get(\"passedReceivedAt\"));",
              "  pm.expect(body.receivedAt).to.match(/Z$/);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"integrationId\": \"{{integrationId}}\",\n  \"contractId\": \"{{contractId}}\",\n  \"report\": {\n    \"reportId\": \"{{passedReportId}}\",\n    \"contractVersion\": 3,\n    \"status\": \"Passed\",\n    \"violations\": []\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/internal/v1/reports"
      }
    },
    {
      "name": "4. Неправильный actualType: получить 400",
      "description": "",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"invalidReportId\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400: VALIDATION_REPORT_INVALID\", () => {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "  const body = pm.response.json();",
              "  pm.expect(body.code).to.eql(\"VALIDATION_REPORT_INVALID\");",
              "  pm.expect(body.status).to.eql(400);",
              "  pm.expect(body.errors).to.be.an(\"object\");",
              "  pm.expect(body.errors[\"report.violations[0].actualType\"]).to.be.an(\"array\").that.is.not.empty;",
              "  pm.expect(body).not.to.have.property(\"receivedAt\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"integrationId\": \"{{integrationId}}\",\n  \"contractId\": \"{{contractId}}\",\n  \"report\": {\n    \"reportId\": \"{{invalidReportId}}\",\n    \"contractVersion\": 3,\n    \"status\": \"Failed\",\n    \"violations\": [\n      {\n        \"fieldName\": \"amount\",\n        \"type\": \"TypeMismatch\",\n        \"expectedType\": \"Number\",\n        \"actualType\": \"Number\"\n      }\n    ]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/internal/v1/reports"
      }
    },
    {
      "name": "5. Поврежденный JSON: получить 400",
      "description": "",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400: INVALID_REQUEST\", () => {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "  const body = pm.response.json();",
              "  pm.expect(body.code).to.eql(\"INVALID_REQUEST\");",
              "  pm.expect(body.status).to.eql(400);",
              "  pm.expect(body.errors).to.be.an(\"object\");",
              "  pm.expect(body).not.to.have.property(\"receivedAt\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/internal/v1/reports"
      }
    },
    {
      "name": "6. Неправильный Content-Type: получить 415",
      "description": "",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 415: UNSUPPORTED_MEDIA_TYPE\", () => {",
              "  pm.response.to.have.status(415);",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "  const body = pm.response.json();",
              "  pm.expect(body.code).to.eql(\"UNSUPPORTED_MEDIA_TYPE\");",
              "  pm.expect(body.status).to.eql(415);",
              "  pm.expect(body.errors).to.be.an(\"object\");",
              "  pm.expect(body).not.to.have.property(\"receivedAt\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/plain"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"integrationId\": \"{{integrationId}}\",\n  \"contractId\": \"{{contractId}}\",\n  \"report\": {\n    \"reportId\": \"{{$guid}}\",\n    \"contractVersion\": 3,\n    \"status\": \"Passed\",\n    \"violations\": []\n  }\n}",
          "options": {
            "raw": {
              "language": "text"
            }
          }
        },
        "url": "{{baseUrl}}/internal/v1/reports"
      }
    }
  ]
}
